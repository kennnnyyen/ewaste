# Canonical website origin is defined in app/site-config.ts as https://www.recore-cycle.com.

# Server-only Gmail SMTP configuration. Never use NEXT_PUBLIC_ for credentials.
# GMAIL_USER is the authenticated sending account, independent of the receiver.
GMAIL_USER=
# Generate a Google App Password with 2-Step Verification enabled.
# Store the real value only in .env.local or Vercel's sensitive environment variables.
GMAIL_APP_PASSWORD=
# Website form recipient.
ENQUIRY_TO_EMAIL=info@recore-cycle.com
# Compatibility with the currently deployed Resend enquiry handler.
RESEND_TO_EMAIL=info@recore-cycle.com
RESEND_FROM_EMAIL="Recore website <info@recore-cycle.com>"

# Incoming info@recore-cycle.com mail forwarded through Resend.
# Use the Recore team's full-access key and this endpoint's signing secret.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Final Gmail inbox for incoming domain mail. Must differ from info@recore-cycle.com.
RECORE_FORWARD_TO_EMAIL=
